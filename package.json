{
  "name": "yimpim",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "check": "tsc --noEmit",
    "check:test": "tsc -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "doctor": "node dist/index.js doctor",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "openai": "^6.0.0",
    "opentype.js": "2.0.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "yimpim": "./dist/index.js",
    "yp": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets/fonts",
    "assets/ui",
    "README.md",
    "LICENSE"
  ]
}
